{
  "realm": "demo",
  "displayName": "Kotlin Keycloak Demo",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "client": {
      "demo-api": [
        {
          "name": "USER"
        },
        {
          "name": "ADMIN"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "demo-api",
      "name": "Kotlin Resource Server",
      "protocol": "openid-connect",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "demo-browser",
      "name": "Browser Demo (PKCE)",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:8080/"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "demo-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "api-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "demo-api",
            "claim.name": "resource_access.demo-api.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "demo-cli",
      "name": "Local Smoke Tests Only",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "demo-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "api-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "demo-api",
            "claim.name": "resource_access.demo-api.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "email": "demo@example.test",
      "firstName": "Demo",
      "lastName": "User",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "demo123",
          "temporary": false
        }
      ],
      "clientRoles": {
        "demo-api": [
          "USER"
        ]
      }
    },
    {
      "username": "manager",
      "enabled": true,
      "emailVerified": true,
      "email": "manager@example.test",
      "firstName": "Demo",
      "lastName": "Manager",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "manager123",
          "temporary": false
        }
      ],
      "clientRoles": {
        "demo-api": [
          "USER",
          "ADMIN"
        ]
      }
    }
  ],
  "clientScopeMappings": {
    "demo-api": [
      {
        "client": "demo-browser",
        "roles": [
          "USER",
          "ADMIN"
        ]
      },
      {
        "client": "demo-cli",
        "roles": [
          "USER",
          "ADMIN"
        ]
      }
    ]
  }
}
